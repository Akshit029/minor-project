# ==============================================================================
# Git Ignore Configuration
# Spatiotemporal Weather Forecast Reliability & Uncertainty Project
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Sensitive Credentials
.env
.env.*
*.env
!.env.example
!frontend/.env.example
.cdsapirc
credentials.json
*.pem
*.key

# Data and Raw Binary Meteorology Files
data/raw/gfs/*.grb2
data/raw/gfs/*.grib2
data/raw/gfs/*.idx
data/raw/era5/*.nc
data/raw/era5/*.grib

# Preserve Directory Structures
!data/raw/gfs/.gitkeep
!data/raw/era5/.gitkeep
!data/processed/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/reports/.gitkeep

# IDEs, Editors & OS Metadata
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
