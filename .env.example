# ==============================================================================
# WEATHER FORECAST RELIABILITY & UNCERTAINTY DETECTION - ENVIRONMENT VARIABLES
# ==============================================================================

# FastApi Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production

# Automated Forecast-Bust Alert Threshold (0.00 to 1.00)
ALERT_THRESHOLD=0.60

# Optional Google Gemini API Key for Week 6 LangChain AI Conversational Assistant
# (When empty or unset, the system operates deterministically using scientific lookup tools)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Optional SMTP Email Alerting Configuration
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_RECIPIENT=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend Configuration (for development with Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false
